# PostgreSQL
POSTGRES_USER=lifehub
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=lifehub

# Backend
SECRET_KEY=replace_with_at_least_32_random_bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Ports (opzionali)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Debug
DEBUG=false
CORS_ORIGINS=http://localhost:3000
